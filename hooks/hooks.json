{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/setup.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/track-workers.sh session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Bash|KillShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/track-workers.sh pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Bash|BashOutput",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/track-workers.sh post"
          }
        ]
      }
    ]
  }
}
